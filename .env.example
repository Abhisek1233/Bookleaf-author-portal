# ==============================================================================
# BookLeaf Author Support & Communication Portal - Environment Configuration
# ==============================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:5173

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://postgres:root@localhost:5432/bookleaf_support?schema=public

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_bookleaf_support_portal_2026_dev
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration
# Optional in development: if omitted or invalid, deterministic heuristic fallback is activated automatically
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Seed Credentials (Default passwords hashed into database during seed)
ADMIN_DEFAULT_PASSWORD=AdminPassword123!
AUTHOR_DEFAULT_PASSWORD=Author123!
